# ============================================================
# Python (ai_engine)
# ============================================================
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
*.egg-info/

# Trained models — regenerable via `python train_models.py`.
# Don't commit binary model weights; anyone can rebuild them from
# the CSVs, and .joblib files bloat the repo with every retrain.
ai_engine/models/*.joblib

# ============================================================
# Node (backend)
# ============================================================
node_modules/
npm-debug.log*
backend/node_modules/

# ============================================================
# Environment / secrets — NEVER commit real .env files
# ============================================================
.env
.env.local
backend/.env
ai_engine/.env

# ============================================================
# OS / editor junk
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================================================
# Docker
# ============================================================
*.pid

# ============================================================
# NOTE ON CSVs — deliberately NOT ignored
# ============================================================
# The synthetic CSVs (assets.csv, corridors.csv, maintenance_tasks.csv,
# etc.) are small (<150KB each) and teammates need them immediately
# without running generate_data.py first — keep these committed.
#
# Train_details_22122017.csv (~16MB) and ir_train-part-004.csv (~22MB)
# are real source data that CANNOT be regenerated by any script — if
# you .gitignore these, anyone who clones fresh loses them permanently
# unless they're shared separately. Both are under GitHub's 100MB hard
# limit, so committing them as-is is fine for a hackathon repo. If the
# repo starts feeling slow to clone, revisit this with Git LFS.
